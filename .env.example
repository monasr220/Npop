# =============================================================================
# Npop environment configuration
# =============================================================================
# Copy this file to `.env` in the project root (or `app/.env`) and adjust the
# values. Never commit the real `.env`; it is ignored by git.
#
# All settings are read by `app/core/config.py`. Unknown keys are ignored.

# -------------------------------------------------------------------- runtime
# development | staging | production
ENVIRONMENT=development
DEBUG=false
SERVER_HOST=127.0.0.1
SERVER_PORT=5001

# ------------------------------------------------------------------- database
# SQLite by default. The working database is app.db; new.db is read-only seed
# data and must not be used as DATABASE_URL.
# DATABASE_URL=sqlite:///D:/Nasr/new/app.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/npop

# ------------------------------------------------------------------ cloudinary
# Required only for file uploads. Hosted media URLs work without these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------ auth
# Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# A missing or weak key is generated automatically in development, but the app
# refuses to start with one when ENVIRONMENT=production.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------ CORS
# Comma-separated explicit allow-list. Leave empty for same-origin production
# deployments. Localhost and Vite origins are allowed automatically in
# development.
# CORS_ORIGINS=https://npop.example.com,https://www.npop.example.com
CORS_ORIGINS=

# --------------------------------------------------------------- rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=30/minute
# memory:// works for a single process; use redis://host:6379 for multiple
# workers or instances.
RATE_LIMIT_STORAGE_URI=memory://

# -------------------------------------------------------------------- uploads
MAX_AUDIO_UPLOAD_MB=50
MAX_IMAGE_UPLOAD_MB=10

# -------------------------------------------------------------------- logging
LOG_LEVEL=INFO
# true -> one JSON object per line; false -> compact human-readable logs
LOG_JSON=true
